    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch and Debug Blazor WebAssembly in Chrome",
            "type": "blazorwasm",
            "request": "launch",
            "cwd": "${workspaceFolder}/LeloPage",
            "browser": "chrome"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Chrome against localhost",
            "url": "http://localhost:5221",
            "webRoot": "${workspaceFolder}/LeloPage/wwwroot"
        }
    ]
}