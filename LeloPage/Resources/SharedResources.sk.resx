  <data name="Artist.Reservation.Title" xml:space="preserve">
    <value>Rezervácia hodiny</value>
  </data>
  <data name="Artist.Reservation.Description" xml:space="preserve">
    <value>Vyberte si dostupný termín v kalendári nižšie a rezervujte si hodinu maľby. Individuálne hodiny sú prispôsobené vašej úrovni a cieľom — či začínate od nuly, alebo rozvíjate existujúcu prax.</value>
  </data>
