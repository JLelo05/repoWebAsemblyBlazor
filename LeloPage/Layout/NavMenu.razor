@inject IStringLocalizer<SharedResources> Localizer
@inject CultureService CultureService
@implements IDisposable

<div class="topbar-navbar navbar navbar-dark">
    <div class="container-fluid d-flex align-items-center justify-content-between">
        <a class="navbar-brand" href=""></a>
        <nav class="nav flex-row">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="artist">
                    <span class="bi bi-paint-brush-nav-menu" aria-hidden="true"></span> @Localizer["Nav.Artist"]
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="counter">
                    <span class="bi bi-paint-brush-nav-menu" aria-hidden="true"></span> @Localizer["Nav.Counter"]
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> @Localizer["Nav.Home"]
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="weather">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> @Localizer["Nav.Weather"]
                </NavLink>
            </div>
        </nav>
        <div class="d-flex align-items-center">
            <LanguageSwitcher />
            <button title="@Localizer["Nav.NavigationMenu"]" class="navbar-toggler ms-2" @onclick="ToggleNavMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
        </div>
    </div>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    protected override void OnInitialized()
    {
        CultureService.OnCultureChanged += StateHasChanged;
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    public void Dispose()
    {
        CultureService.OnCultureChanged -= StateHasChanged;
    }
}
