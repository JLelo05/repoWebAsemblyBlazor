@page "/counter"
@inject IStringLocalizer<SharedResources> Localizer
@inject CultureService CultureService
@implements IDisposable

<PageTitle>@Localizer["Counter.PageTitle"]</PageTitle>

<h1>@Localizer["Counter.Title"]</h1>

<p role="status">@Localizer["Counter.CurrentCount"]: @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">@Localizer["Counter.ClickMe"]</button>

@code {
    private int currentCount = 0;

    protected override void OnInitialized()
    {
        CultureService.OnCultureChanged += StateHasChanged;
    }

    private void IncrementCount()
    {
        currentCount++;
    }

    public void Dispose()
    {
        CultureService.OnCultureChanged -= StateHasChanged;
    }
}
